# Input: 使用者填写的本地连接信息与密钥
# Output: 供 Settings/脚本加载的环境变量示例
# Pos: 环境变量模板（变更时同步更新以上注释与所属目录 FOLDER.md）

# Copy to .env and fill values

# Logging
# Set DEBUG to see streaming progress logs for /chat/stream.
TXNEWS_LOG_LEVEL=INFO

# Postgres
# - Docker Compose / K8s: use service DNS
# - Host direct-run: replace `postgres` with `localhost`
TXNEWS_PG_DSN=postgresql+psycopg://txnews:txnews@postgres:5432/txnews

# Redis (Celery broker/result backend)
TXNEWS_REDIS_URL=redis://redis:6379/0

# NATS
TXNEWS_NATS_URL=nats://nats:4222
TXNEWS_NATS_STREAM=txnews

# MinIO / S3
TXNEWS_S3_ENDPOINT=http://minio:9000
TXNEWS_S3_ACCESS_KEY=txnews
TXNEWS_S3_SECRET_KEY=txnewssecret
TXNEWS_S3_BUCKET=txnews-raw
TXNEWS_S3_REGION=us-east-1

# Qdrant
TXNEWS_QDRANT_URL=http://qdrant:6333
TXNEWS_QDRANT_COLLECTION=txnews_articles

# DashScope (Qwen3-Max)
DASHSCOPE_API_KEY=

# OpenAI-compatible LLM config (preferred; also works for DashScope compatible-mode)
# If `TXNEWS_LLM_API_KEY` is empty, the code will fall back to `DASHSCOPE_API_KEY`.
TXNEWS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TXNEWS_LLM_MODEL_NAME=qwen3-max
TXNEWS_LLM_API_KEY=

# Full text access (copyright sensitive). Default disabled.
# When enabled, /kb/* APIs and MCP tools may return extracted full text from Postgres.
TXNEWS_ALLOW_FULL_TEXT=0

# Compute mode
# - cpu: worker analysis uses online LLM fallback (if configured); embedding always on CPU
# - gpu: worker analysis prefers local vLLM (llm.deep); embedding always on CPU
# - auto: keep config/config.yaml as-is
TXNEWS_ACCELERATOR=cpu

# vLLM (host / outside Docker; preferred for stability)
# - Start it on host and expose an OpenAI-compatible /v1 endpoint.
# - Containers reach host via `host.docker.internal` (Linux: compose adds host-gateway mapping).
TXNEWS_LLM_DEEP_BASE_URL=http://host.docker.internal:9999/v1
# Used by scripts/start.* when TXNEWS_ACCELERATOR=gpu
TXNEWS_START_VLLM=1
# vLLM startup script (repo provides a default for the bundled merged model)
# TXNEWS_VLLM_SCRIPT=finetune/result_model/deepseekr1_merged/serve_vllm_gpu0_9999.sh
# Optional: explicit python interpreter used by vLLM script (supports venv)
# - Example (Linux): TXNEWS_VLLM_PYTHON=.venv/bin/python
# - Example (Windows): TXNEWS_VLLM_PYTHON=.venv\\Scripts\\python.exe
# TXNEWS_VLLM_PYTHON=
# Optional: auto-bootstrap vLLM conda env (used when conda exists and TXNEWS_VLLM_PYTHON is not set)
# TXNEWS_VLLM_AUTO_INSTALL=1
# TXNEWS_VLLM_CONDA_ENV=vllm
# TXNEWS_VLLM_CONDA_PYTHON=3.11
# TXNEWS_VLLM_PIP_SPEC=vllm
# TXNEWS_VLLM_RECREATE_CONDA_ENV=0
# TXNEWS_VLLM_PORT=9999
# TXNEWS_VLLM_TIMEOUT_SECONDS=900
# TXNEWS_VLLM_LOG_FILE=var/log/vllm.log

# Docker log streaming (start scripts)
# TXNEWS_FOLLOW_LOGS=1 will `docker compose logs -f` and block in foreground.
# TXNEWS_FOLLOW_LOGS=0 will print tail logs and exit.
TXNEWS_FOLLOW_LOGS=1
# TXNEWS_COMPOSE_LOG_FILE=var/log/compose.log

# Optional: explicit embedding device override (highest priority)
# Embedding now always uses CPU by default, but can be overridden if needed
# Examples: cpu / auto / cuda / cuda:1
# TXNEWS_EMBEDDING_DEVICE=cpu

# Optional: split LLM config by role (overrides TXNEWS_LLM_*)
# Chat (API/UI + pipeline analyze)
# TXNEWS_LLM_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# TXNEWS_LLM_CHAT_MODEL_NAME=qwen3-max
# TXNEWS_LLM_CHAT_API_KEY=
#
# Deep analysis (worker deep_optimize; recommended local vLLM)
# TXNEWS_LLM_DEEP_MODEL_NAME=deepseekr1-merged
# TXNEWS_LLM_DEEP_API_KEY=local

# Per-user online LLM config (Redis-backed; configured via http://localhost:8001/)
# When enabled, /chat and /chat/stream will use the user's own base_url/model/api_key to split costs.
# TXNEWS_REQUIRE_USER_LLM=1
# TXNEWS_USER_LLM_TTL_SECONDS=2592000

# HuggingFace Hub (embedding model download)
# Use a mirror if huggingface.co is slow/unreachable.
HF_ENDPOINT=https://hf-mirror.com
# Optional: HuggingFace cache dir (compose 默认挂载到 /app/var/hf)
# HF_HOME=/app/var/hf

# Build-time mirrors (Docker image build acceleration; optional)
# These are passed as build args into `docker/Dockerfile` via `docker-compose.yml`.
# - pip (Aliyun): https://mirrors.aliyun.com/pypi/simple/
# - pip (TUNA):  https://pypi.tuna.tsinghua.edu.cn/simple
# - npm (npmmirror): https://registry.npmmirror.com
# - Debian (Aliyun): http://mirrors.aliyun.com/debian , http://mirrors.aliyun.com/debian-security
# TXNEWS_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# TXNEWS_PIP_TRUSTED_HOST=mirrors.aliyun.com
# TXNEWS_NPM_REGISTRY=https://registry.npmmirror.com
# TXNEWS_DEBIAN_MIRROR=http://mirrors.aliyun.com/debian
# TXNEWS_DEBIAN_SECURITY_MIRROR=http://mirrors.aliyun.com/debian-security
