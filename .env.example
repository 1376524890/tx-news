# Copy to .env and fill values

# Postgres
TXNEWS_PG_DSN=postgresql+psycopg://txnews:txnews@localhost:5432/txnews

# Redis (Celery broker/result backend)
TXNEWS_REDIS_URL=redis://localhost:6379/0

# NATS
TXNEWS_NATS_URL=nats://localhost:4222
TXNEWS_NATS_STREAM=txnews

# MinIO / S3
TXNEWS_S3_ENDPOINT=http://localhost:9000
TXNEWS_S3_ACCESS_KEY=txnews
TXNEWS_S3_SECRET_KEY=txnewssecret
TXNEWS_S3_BUCKET=txnews-raw
TXNEWS_S3_REGION=us-east-1

# Qdrant
TXNEWS_QDRANT_URL=http://localhost:6333
TXNEWS_QDRANT_COLLECTION=txnews_articles

# DashScope (Qwen3-Max)
DASHSCOPE_API_KEY=

